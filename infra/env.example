# Copy to apps/api/.env for local development. Never commit real values.
# Fictional development passwords are NOT configured here: the seed script generates them into the
# ignored file apps/api/.dev-credentials.json.

# PostgreSQL (scripts/dev-db.sh starts a dedicated loopback cluster on port 5433).
GEEVI_DATABASE_URL=postgresql+psycopg://geevi@127.0.0.1:5433/geevi

# Enables fictional development identities, demo seeding and the fixture loader. Leave false anywhere
# that is not an explicit local demonstration.
GEEVI_DEV_MODE=true

# Browser origins allowed to perform writes (the Next.js frontend).
GEEVI_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Set true when the frontend is served over HTTPS so the session cookie is Secure.
GEEVI_COOKIE_SECURE=false
GEEVI_SESSION_HOURS=12
GEEVI_MAX_UPLOAD_BYTES=5000000
GEEVI_MAX_ARCHIVE_BYTES=60000000

# Frontend (apps/web): where the same-origin /api/v1 proxy forwards to.
# GEEVI_API_ORIGIN=http://127.0.0.1:8000
